# RESEARCH_* feature flags for docker-compose.yml (app service).
#
# Scope: this file covers only the RESEARCH_* env vars -- the research-tools
# sprint's server-side master switches (see app/src/lib/config/research-flags.ts
# and docs/adr/ADR-035-research-mode-gating-supersedes-033.md). It is not an
# exhaustive .env reference for the whole project.
#
# Per ADR-035, gating is per-deployment (these env vars), not per-user.
# All flags default to false; copy this file to .env and flip individual
# flags to `true` to enable that capability in your local deployment.

# WS-4 -- research target model, state, breadcrumbs, graph re-centering.
RESEARCH_TARGETS=false
# WS-3 -- snippet capture + snippet_blobs + snippet_tags.
RESEARCH_SNIPPETS=false
# WS-1 -- parse_field_outcomes writes + regression reports + selector audit.
RESEARCH_PARSER_TELEMETRY=false
# WS-5 -- source_records + connectors (Wayback, EDGAR, RSS, news, blog, podcast).
RESEARCH_SOURCES=false

# Phase 3 Track G -- targeted news scrapers master switch. Per-site sub-flags
# below only take effect when this is also true.
RESEARCH_CONNECTOR_NEWS=false
RESEARCH_CONNECTOR_NEWS_WSJ=false
RESEARCH_CONNECTOR_NEWS_BLOOMBERG=false
RESEARCH_CONNECTOR_NEWS_REUTERS=false
RESEARCH_CONNECTOR_NEWS_TECHCRUNCH=false
RESEARCH_CONNECTOR_NEWS_CNBC=false

# Phase 3 Track G -- podcast RSS + transcript connector.
RESEARCH_CONNECTOR_PODCAST=false
